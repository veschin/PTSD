project:
  name: "{{.Name}}"
  tool: "{{.Tool}}"

testing:
{{- if .Runner}}
  runner: "{{.Runner}}"
{{- end}}
  patterns:
    files: []

review:
  min_score: 7
  auto_redo: true

hooks:
  pre_commit: true
  scopes: [PRD, SEED, BDD, TEST, IMPL, TASK, STATUS]
  types: [feat, add, fix, refactor, remove, update]

pipeline:
  default: standard
